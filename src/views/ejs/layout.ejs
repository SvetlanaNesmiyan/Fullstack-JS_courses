<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="nav-brand">
        <a href="/">Express Server</a>
      </div>
      <ul class="nav-menu">
        <li><a href="/">Головна</a></li>
        <li><a href="/users">Користувачі</a></li>
        <li><a href="/articles">Статті</a></li>
        <li><a href="/auth">Авторизація</a></li>
        <% if (typeof user !== 'undefined' && user) { %>
          <li><a href="/settings">Налаштування</a></li>
          <li class="nav-user">
            <span>Вітаємо, <strong><%= user.username || user.email %></strong></span>
            <a href="/auth/logout" class="btn-logout">Вихід</a>
          </li>
        <% } else { %>
          <li><a href="/auth/login">Вхід</a></li>
          <li><a href="/auth/register">Реєстрація</a></li>
        <% } %>
      </ul>
    </div>
  </nav>
  
  <main class="main-content container">
    <%- body %>
  </main>
  
  <footer class="footer">
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> Express Server з MongoDB Atlas</p>
    </div>
  </footer>
</body>
</html>