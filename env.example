# Порт сервера
PORT=3000

# JWT Secret ключ
JWT_SECRET=your-jwt-secret-key-change-in-production

# MongoDB URI
# Для локального MongoDB: mongodb://localhost:27017/express-server
# Для MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/express-server

# Секретний ключ сесії (ЗМІНІТЬ В ПРОДАКШЕНІ!)
SESSION_SECRET=your-secret-key-change-in-production

# Node environment
NODE_ENV=development
